# ====================================================================
# Telegram AI Agent Bot Configuration - Environment Variables Example
# Copy this file to '.env' and fill in your actual credentials.
# ====================================================================

# 1. Telegram Configurations
# Retrieve this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The base URL where this application is hosted (e.g. on Render)
# Do NOT include a trailing slash or '/webhook' here
WEBHOOK_URL=https://your-app-subdomain.onrender.com

# A secret token Telegram will send in headers for security.
# Choose a long random string (alphanumeric, underscores, hyphens)
WEBHOOK_SECRET_TOKEN=a_long_random_alphanumeric_secret_string_here

# 2. LLM / Z.ai Configurations
# Get your API key from the Zhipu AI platform
ZAI_API_KEY=your_zhipu_ai_api_key_here

# Model name to use (default is the permanently free glm-4.7-flash)
MODEL_NAME=glm-4.7-flash

# 3. Database Configurations
# Your Neon PostgreSQL Connection String (starts with postgresql:// or postgres://)
# Example: postgres://alex:pwd@ep-cool-rock-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# 4. Server Configurations (Optional overrides)
PORT=8000
HOST=0.0.0.0

# Max concurrent LLM API calls. 1 serializes every chat behind one another;
# 2 is a safe default for the Z.ai free tier.
LLM_CONCURRENCY=2

# Sandbox directory the whitelisted shell tool runs inside. Defaults to
# ./workspace next to the code. Keep it OUTSIDE any dir containing .env.
# TOOL_WORKSPACE_DIR=/absolute/path/to/workspace

# 5. Allowed User IDs for Private DM chats and activation commands (comma-separated)
ALLOWED_DM_USER_IDS=2030903420,8116285130

